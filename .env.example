# Copy this file to .env.local and fill in real values as you provision each service.
# The app boots and the public site works with NONE of these set — every integration
# degrades to a "not configured" state instead of crashing. See README.md for setup steps.
#
# Most vars below are suffixed _SGA to avoid colliding with other projects that share
# your Neon/Resend/UploadThing accounts (e.g. another project's DATABASE_URL). The two
# Clerk keys are the exception — Clerk's SDK auto-detects those exact standard names
# throughout the app, so renaming them would require extra explicit wiring for no benefit.

# --- Neon Postgres (https://console.neon.tech) ---
# Use the pooled connection string for the app, and the direct (unpooled) one for drizzle-kit migrations.
DATABASE_URL_SGA=
DATABASE_URL_UNPOOLED_SGA=

# --- Clerk (https://dashboard.clerk.com) — admin auth ---
# These two keep Clerk's standard (unsuffixed) names on purpose — see note above.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login
CLERK_WEBHOOK_SIGNING_SECRET_SGA=

# --- Resend (https://resend.com) — waitlist confirmation + internal notifications ---
RESEND_API_KEY_SGA=
RESEND_FROM_EMAIL_SGA="SGA <onboarding@resend.dev>"
SGA_TEAM_NOTIFICATION_EMAIL=

# --- UploadThing (https://uploadthing.com) — blog cover images ---
UPLOADTHING_TOKEN_SGA=

# --- Site config ---
NEXT_PUBLIC_SITE_URL_SGA=http://localhost:3000
